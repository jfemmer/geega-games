# ---------------------------------------------------------------------------
# Geega Games — environment variables
# Copy to .env for local dev. NEVER commit a real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Browser (safe to expose; bundled into the client) ----------------------
# Only the Supabase PUBLISHABLE key may live in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public site config used by the storefront UI.
VITE_PUBLIC_SITE_URL=
# Leave empty until a monitored inbox exists; empty hides the support line.
VITE_SUPPORT_EMAIL=

# Google Maps JavaScript API key for Places address autocomplete on signup.
# This key is intentionally browser-visible, so restrict it in Google Cloud to
# your production/preview/local origins and to the Maps JavaScript API / Places API.
VITE_GOOGLE_MAPS_API_KEY=

# Where the admin Scan Sessions page looks for a locally-running
# scanner-bridge (see scanner-bridge/README.md) to show its live status.
# Only relevant on the machine actually running the bridge; harmless
# everywhere else (the panel just shows "not connected"). Leave empty to
# use the bridge's own default, http://127.0.0.1:8787 — set this only if
# you changed STATUS_PORT in scanner-bridge/.env.
VITE_SCANNER_BRIDGE_URL=

# Stripe publishable key (safe to expose). Leave empty to keep card payment
# off — checkout falls back to "payment not yet enabled" for balance-due
# orders. Use a test-mode key (pk_test_...) until you're ready to go live.
VITE_STRIPE_PUBLISHABLE_KEY=

# PayPal REST app client id (public). Enables the PayPal + Venmo buttons on
# the checkout payment step. Same value as PAYPAL_CLIENT_ID below. Use the
# Sandbox app's id until you're ready to go live.
VITE_PAYPAL_CLIENT_ID=

# --- Server only (NEVER prefixed with VITE_; never sent to the browser) ------
# Used by the Vercel Functions under /api.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=Geega Games <updates@geega-games.com>
RESEND_FROM_ORDERS=Geega Games <orders@geega-games.com>
RESEND_REPLY_TO=support@geega-games.com
# Optional. Where staff notifications land — new buying leads and new online
# orders respectively. Both default to RESEND_REPLY_TO if left empty.
SELL_LEADS_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# Public base URL used to build links inside emails (no trailing slash).
PUBLIC_SITE_URL=https://geega-games.com

# Secret used to HMAC confirmation/unsubscribe tokens. Generate a long random
# value, e.g. `openssl rand -base64 48`.
EMAIL_TOKEN_SECRET=

# --- Payments ----------------------------------------------------------------
# Secret key, server-only (sk_test_... / sk_live_...). Required for
# /api/checkout/create-payment-intent to create PaymentIntents.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (whsec_...) — from the Stripe
# Dashboard's webhook config for https://<your-domain>/api/webhooks/stripe,
# subscribed to at least payment_intent.succeeded. This is the ONLY place an
# order is marked paid; never trust the browser for that.
STRIPE_WEBHOOK_SECRET=

# --- PayPal / Venmo --------------------------------------------------------
# From developer.paypal.com → Apps & Credentials (a REST app on a PayPal
# Business account). Venmo is accepted through the same app — no separate
# Venmo credentials exist.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live". Must match the credentials above.
PAYPAL_ENV=sandbox
# Id of the webhook registered in the same REST app for
# https://<your-domain>/api/webhooks/paypal, subscribed to
# CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED,
# PAYMENT.CAPTURE.REFUNDED and PAYMENT.CAPTURE.REVERSED.
PAYPAL_WEBHOOK_ID=

# --- Shipping ------------------------------------------------------------
# Optional. Enables "Buy & print label" on the admin Orders page (buys real
# USPS postage via EasyPost and marks the order shipped) instead of only the
# manual carrier/tracking-number entry. Get a production API key from
# https://www.easypost.com (Settings → API Keys) after funding your account
# with a payment method for postage. Leave empty to keep that feature
# disabled with a clear message — everything else keeps working.
EASYPOST_API_KEY=

# --- Admin app push notifications (optional) ---
# Lets staff get phone/desktop notifications from the installable admin app
# (new orders, buying leads, offer responses, partner leads, pickups).
# Generate a key pair once with:  npx web-push generate-vapid-keys
# Never change the pair after staff have turned notifications on — existing
# devices would have to turn them on again. Server-only; no VITE_ prefix.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach you at. Defaults to mailto:RESEND_REPLY_TO.
VAPID_SUBJECT=
