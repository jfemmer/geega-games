# Copy this file to .env and fill in every value. Never commit the real .env
# — it holds a real staff password. This bridge never uses the Supabase
# service_role key; it signs in as a real staff account, exactly like the
# browser admin app does.

# Your deployed Geega app's URL, no trailing slash. Use the same address
# you open the admin dashboard at: the bridge only talks to that site, so
# the dashboard's Scanner panel can't reach it from any other address.
GEEGA_API_BASE_URL=https://your-geega-deployment.vercel.app

# From Supabase project settings → API. The anon/publishable key is fine —
# it is the same key the browser app ships with, safe to distribute.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Create ONE dedicated staff account for this bridge (Users page in the
# admin app, or Supabase Auth) rather than reusing a human's login, so its
# activity is attributable and its access can be revoked independently.
GEEGA_STAFF_EMAIL=scanner-bridge@yourdomain.com
GEEGA_STAFF_PASSWORD=change-me

# The folder PaperStream IP is configured to save scans into. Use an
# absolute Windows path, e.g. C:\GeegaScans\Incoming
WATCH_FOLDER=C:\GeegaScans\Incoming

# Optional — default to subfolders of WATCH_FOLDER if omitted.
# PROCESSED_FOLDER=C:\GeegaScans\Incoming\_processed
# FAILED_FOLDER=C:\GeegaScans\Incoming\_failed

# What recognition does for every card in sessions this bridge creates:
# "both" (identify + grade condition), "card_matching" (identify only —
# grade condition manually), or "condition" (grade condition only —
# match each card manually in Scan Review). This also decides whether the
# bridge expects one file per card (card_matching — front only) or two
# (condition/both — front + back, fi-8170 duplex ADF order) — there's no
# separate duplex setting, it follows directly from what you're scanning for.
# "both" (the default) also gives the card recognizer both sides of every
# card, so face-down and double-faced cards are handled.
SCAN_MODE=both

# Recorded on the scan session; never used to branch behavior.
SCANNER_NAME=Ricoh fi-8170

# Direct scanning ("Scan now" in the admin dashboard, no PaperStream IP
# window) is driven by NAPS2 (https://www.naps2.com/download), a free
# third-party scanning utility — install it separately on this PC first.
# Path to its console executable; the default matches a standard install.
# NAPS2_CONSOLE_PATH=C:\Program Files\NAPS2\NAPS2.Console.exe

# Which backend NAPS2 uses to talk to the driver: twain, wia, escl, sane,
# or apple. "twain" is the default and the one confirmed to work against
# the fi-8170's real driver (its WIA support turned out not to implement
# scanning at all, even though PaperStream IP drives the same hardware
# fine — see scanner-bridge/README.md section 7 for the full story).
# SCANNER_DRIVER=twain

# Substring to find the right scan device by name (case-insensitive). The
# default ("8170", the model number) should match regardless of exact
# driver naming/casing, but if "Check scanner connection" in the admin
# dashboard reports no match, set this to whatever name it lists instead.
# SCANNER_DEVICE_NAME_MATCH=8170

# Milliseconds of no new files before a batch is processed. PaperStream
# writes a whole feed run's pages in a burst — this must be longer than the
# gap between pages within one run, and shorter than the gap between runs.
BATCH_QUIET_MS=5000

# Local-only status endpoint (http://127.0.0.1:<port>/status). Never exposed
# beyond this machine.
STATUS_PORT=8787

# Resolution for "Scan now". 300 (the default) is the fi-8170's full speed
# and all card identification needs; condition-only sessions default to 600.
# On the dashboard's "Scan now", this is the Inventory scan's resolution;
# Condition and Inventory + condition scans always use 600.
# One of 200, 240, 300, 400, 600.
# SCAN_DPI=300

# --- Card recognition on this PC (README section 8) -------------------------
# Identifies each card here before upload — free, no paid service. On first
# start it downloads its model (88 MB) and builds the card library from the
# shop's Scryfall card list (a few hours, in the background); until then
# cards go to the cloud recognizer. Set to off to always use the cloud.
# On Windows it needs Microsoft's Visual C++ Redistributable (x64), which
# most PCs already have; if this one doesn't, the dashboard says so and
# links to it, and scanning carries on meanwhile.
# RECOGNIZER=on

# Where the model, card library and Scryfall image cache live.
# Default: %LOCALAPPDATA%\GeegaScannerBridge
# DATA_DIR=D:\GeegaScannerData

# Rebuild the library automatically (first run, and weekly).
# LIBRARY_AUTO_UPDATE=true
# LIBRARY_MAX_AGE_DAYS=7

# Parallel Scryfall image downloads while building the library.
# DOWNLOAD_CONCURRENCY=8

# Size cap for the folder of Scryfall images kept for the pixel check.
# REFERENCE_CACHE_MB=2048

# Processor threads for the recognizer (default: up to 4, leaving one free).
# RECOGNIZER_THREADS=4

# Cards in the self-test run after each library build.
# SELF_TEST_SAMPLES=200
